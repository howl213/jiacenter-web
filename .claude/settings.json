{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/harness_script/claude_guard.py\"",
            "timeout": 15,
            "statusMessage": "위험 명령 점검"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/harness_script/session_brief.py\"",
            "timeout": 20,
            "statusMessage": "프로젝트 상태 확인"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/harness_script/prompt_reminder.py\"",
            "timeout": 10,
            "statusMessage": "작업 규칙 알림"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/harness_script/stop_check.py\"",
            "timeout": 60,
            "statusMessage": "끝내기 전 빠른 점검"
          }
        ]
      }
    ]
  }
}
