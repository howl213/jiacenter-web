# 운영 서버에서 설정할 환경변수. 실제 값이 든 .env 는 커밋하지 않는다(.gitignore).
# 개발 환경에서는 아무것도 설정하지 않아도 동작한다.

# 50자 이상의 임의 문자열. 유출되면 세션 위조가 가능하다.
# 생성: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# 운영에서는 반드시 0. 켜두면 에러 화면에 설정과 소스가 노출된다.
DJANGO_DEBUG=0

# 이 서버가 응답할 도메인. 쉼표로 구분.
DJANGO_ALLOWED_HOSTS=example.kr

# 관리자 화면 주소. 비우면 admin/. 운영에서는 추측하기 어려운 값(끝에 / 필요, 앞에는 없음). 예: manage-7f3k/
DJANGO_ADMIN_PATH=

# Caddy·nginx 같은 HTTPS 프록시 뒤에서 돌릴 때만 1. 프록시 없이 1 로 두면 안 된다.
DJANGO_BEHIND_PROXY=1
